{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aurionstudios",
  "main": "server/worker.js",
  "compatibility_date": "2026-10-08",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "STORE",
        "class_name": "AurionStore"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "AurionStore"
      ]
    }
  ],
  "build": {
    "command": "node scripts/build.mjs"
  }
}
